{
  // Cloudflare Workers config. Only used when deploying to Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delightsheriff-portfolio",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "routes": [{ "pattern": "www.delightsheriff.com", "custom_domain": true }],
  "observability": { "enabled": true },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "delightsheriff-portfolio" }
  ],
  // The site is static and binds no storage. This migration was applied by an earlier deploy
  // and stays listed as history. Nothing calls the class any more.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }]
}
